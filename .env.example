# DataForSEO API Key (base64 of login:password)
DATAFORSEO_API_KEY=your-dataforseo-api-key

# OpenSEO Settings
OPENSEO_ALLOWED_HOST=localhost
OPENSEO_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
OPENSEO_HOST_PORT=3005

# Google Search Console & Google Analytics 4 (OAuth 2.0 Web Client)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
BETTER_AUTH_SECRET=your-32-char-random-secret

# Optional: Cloudflare Tunnel
TUNNEL_TOKEN=your-tunnel-token
